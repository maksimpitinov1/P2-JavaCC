/*
 * Compilador Mini-REXX implementado con JavaCC
 * Autor: Maksim Pitinov
 * Analiza programas escritos en Mini-REXX y genera instrucciones
 * para una máquina virtual de pila
 */

options {
    STATIC = false;
    JAVA_UNICODE_ESCAPE = false;
    ERROR_REPORTING = true;
}

/*
 * Código Java asociado al parser.
 * Incluye la gestión de etiquetas, la lectura de entrada
 * y el tratamiento de errores.
 */
PARSER_BEGIN(REXXCompiler)

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.Locale;

public class REXXCompiler {

    // Contador utilizado para generar etiquetas únicas en los saltos.
    private int nextLabel = 0;

    // Genera una etiqueta nueva para las estructuras de control.
    private String label() {
        return "LBL" + (nextLabel++);
    }

    // Añade un salto de línea a cada instrucción generada.
    private String line(String s) {
        return s + "\n";
    }

    /*
     * Lee el programa desde un archivo (si se proporciona un argumento)
     * o desde la entrada estándar. Después analiza el programa e imprime
     * por pantalla el código de la máquina virtual generado.
     */
    public static void main(String[] args) throws Exception {

        Reader in = args.length == 0
            ? new InputStreamReader(System.in, StandardCharsets.UTF_8)
            : Files.newBufferedReader(
                Paths.get(args[0]), StandardCharsets.UTF_8
            );

        REXXCompiler parser = new REXXCompiler(in);

        try {
            String code = parser.Program();
            System.out.print(code);

        } catch (ParseException e) {
            System.err.println("Error sintáctico: " + e.getMessage());
            System.exit(1);

        } catch (TokenMgrError e) {
            System.err.println("Error léxico: " + e.getMessage());
            System.exit(1);

        } catch (IllegalArgumentException e) {
            System.err.println("Error semántico: " + e.getMessage());
            System.exit(1);
        }
    }
}

PARSER_END(REXXCompiler)

/*
 * Caracteres y separadores que se ignoran durante el análisis.
 * El punto y coma también puede utilizarse como separador de instrucciones.
 */
SKIP :
{
    " " | "\t" | "\r" | "\n" | ";"
}

/*
 * Reconocimiento de comentarios de bloque.
 * Se ignoran y no generan instrucciones para la máquina virtual.
 */
SKIP :
{
    <COMMENT: "/*" ( ~["*"] | "*" ~["/"] )* "*/" >
}

/*
 * Palabras reservadas del lenguaje.
 * Cada letra admite su versión mayúscula o minúscula.
 */
TOKEN :
{
    <PULL: ["p","P"] ["u","U"] ["l","L"] ["l","L"] > |
    <SAY: ["s","S"] ["a","A"] ["y","Y"] > |
    <IF: ["i","I"] ["f","F"] > |
    <THEN: ["t","T"] ["h","H"] ["e","E"] ["n","N"] > |
    <ELSE: ["e","E"] ["l","L"] ["s","S"] ["e","E"] > |
    <DO: ["d","D"] ["o","O"] > |
    <END: ["e","E"] ["n","N"] ["d","D"] > |
    <WHILE: ["w","W"] ["h","H"] ["i","I"] ["l","L"] ["e","E"] > |
    <UNTIL: ["u","U"] ["n","N"] ["t","T"] ["i","I"] ["l","L"] > |
    <TO: ["t","T"] ["o","O"] > |
    <BY: ["b","B"] ["y","Y"] > |
    <SELECT: ["s","S"] ["e","E"] ["l","L"] ["e","E"] ["c","C"] ["t","T"] > |
    <WHEN: ["w","W"] ["h","H"] ["e","E"] ["n","N"] > |
    <OTHERWISE: ["o","O"] ["t","T"] ["h","H"] ["e","E"] ["r","R"] ["w","W"] ["i","I"] ["s","S"] ["e","E"] > |
    <CHOOSE: ["c","C"] ["h","H"] ["o","O"] ["o","O"] ["s","S"] ["e","E"] > |
    <ADDING: ["a","A"] ["d","D"] ["d","D"] ["i","I"] ["n","N"] ["g","G"] > |
    <SUBTRACTING: ["s","S"] ["u","U"] ["b","B"] ["t","T"] ["r","R"] ["a","A"] ["c","C"] ["t","T"] ["i","I"] ["n","N"] ["g","G"] >
}

/*
 * Literales numéricos: secuencias de uno o más dígitos.
 * Los signos se procesan por separado como operadores unarios.
 */
TOKEN :
{
    <NUM: (["0"-"9"])+ >
}

/*
 * Identificadores: comienzan por una letra o guion bajo
 * y pueden continuar con letras, dígitos o guiones bajos.
 */
TOKEN :
{
    <ID: (["a"-"z","A"-"Z","_"])
         (["a"-"z","A"-"Z","0"-"9","_"])* >
}

/*
 * Cadenas entre comillas simples o dobles.
 * No se permiten saltos de línea ni comillas sin cerrar.
 */
TOKEN :
{
    <CAD: "\"" (~["\"","\r","\n"])* "\""
        | "'" (~["'","\r","\n"])* "'" >
}

/*
 * Operadores relacionales y aritméticos, paréntesis y coma.
 * Los operadores de dos caracteres se definen antes que los simples.
 */
TOKEN :
{
    <LE: "<=" > |
    <GE: ">=" > |
    <NE: "<>" > |
    <LT: "<" > |
    <GT: ">" > |
    <EQ: "=" > |
    <PLUS: "+" > |
    <MINUS: "-" > |
    <STAR: "*" > |
    <SLASH: "/" > |
    <LP: "(" > |
    <RP: ")" > |
    <COMMA: "," >
}

/*
 * Programa completo: analiza una secuencia de instrucciones
 * hasta encontrar el final de la entrada.
 */
String Program() :
{
    String code;
}
{
    code=Statements() <EOF>
    {
        return code;
    }
}

/*
 * Secuencia de instrucciones.
 * Concatena el código generado por cada instrucción.
 */
String Statements() :
{
    StringBuilder b = new StringBuilder();
    String s;
}
{
    (
        s=Statement()
        {
            b.append(s);
        }
    )*
    {
        return b.toString();
    }
}

/*
 * Procesa las instrucciones del lenguaje:
 * asignación, PULL, SAY, IF, SELECT y bucles DO.
 * Cada alternativa devuelve las instrucciones de máquina virtual.
 */
String Statement() :
{
    Token id;
    String e;
    String b;
    String c;
    String s;
    StringBuilder out;
    int n;
    Token cad;
    Token cadNum;

    String otherwiseCode;
    String otherwiseLabel;
    String doneLabel;
    String finish;
    String next;
    String top;
    String done;
    String step;
    boolean subtract;
    boolean hasElse;
    String var;
    String init;
    String test;
    String update;
}
{
    /*
     * Asignación: evalúa la expresión y guarda el resultado
     * en la variable indicada.
     */
    id=<ID> <EQ> e=Expression()
    {
        return line("valori " + id.image.toUpperCase(Locale.ROOT))
             + e
             + line("asigna");
    }

  |
    /*
     * PULL: lee un valor desde la entrada estándar
     * y lo almacena en la variable indicada.
     */
    <PULL> id=<ID>
    {
        return line("lee " + id.image.toUpperCase(Locale.ROOT));
    }

  |
    /*
     * SAY: genera las cadenas y expresiones que se van a imprimir.
     * El contador n indica cuántos elementos recibe la instrucción print.
     */
    <SAY>
    {
        out = new StringBuilder();
        n = 0;
    }
    (
        (
            cad=<CAD>
            {
                out.append(line("metecad " + cad.image));
                n++;
            }
          |
            e=Expression()
            {
                out.append(e);
                n++;
            }
        )
        (
            <COMMA>
            (
                cad=<CAD>
                {
                    out.append(line("metecad " + cad.image));
                    n++;
                }
              |
                e=Expression()
                {
                    out.append(e);
                    n++;
                }
            )
        )*
    )
    {
        out.append(line("print " + n));
        return out.toString();
    }

  |
    /*
     * IF: genera un salto condicional.
     * Si existe ELSE, también genera un salto para evitar ejecutar
     * el bloque alternativo después de ejecutar el bloque THEN.
     */
    <IF> c=Condition() <THEN> <DO>
    b=Statements() <END>
    {
        otherwiseLabel = label();
        doneLabel = label();
        otherwiseCode = "";
        hasElse = false;
    }
    [
        <ELSE> <DO> s=Statements() <END>
        {
            otherwiseCode = s;
            hasElse = true;
        }
    ]
    {
        if (!hasElse) {
            return c
                + line("sifalsovea " + otherwiseLabel)
                + b
                + otherwiseLabel + ":\n";
        }

        return c
            + line("sifalsovea " + otherwiseLabel)
            + b
            + line("vea " + doneLabel)
            + otherwiseLabel + ":\n"
            + otherwiseCode
            + doneLabel + ":\n";
    }

  |
    /*
     * SELECT: evalúa los WHEN en orden.
     * Si ninguno se cumple, ejecuta el bloque OTHERWISE si existe.
     * Cada alternativa WHEN que se ejecuta salta al final del SELECT.
     */
    <SELECT>
    {
        out = new StringBuilder();
        finish = label();
    }
    (
        <WHEN> c=Condition() <THEN> <DO>
        b=Statements() <END>
        {
            next = label();

            out.append(c)
               .append(line("sifalsovea " + next))
               .append(b)
               .append(line("vea " + finish))
               .append(next)
               .append(":\n");
        }
    )+
    [
        <OTHERWISE> <DO> s=Statements() <END>
        {
            out.append(s);
        }
    ]
    <END>
    {
        out.append(finish).append(":\n");
        return out.toString();
    }

  |
    /*
     * Bucles DO: se distinguen tres modalidades:
     * WHILE, UNTIL y bucle con contador.
     */
    <DO>
    (
        /*
         * DO WHILE: comprueba la condición antes de ejecutar
         * cada iteración. Si es falsa, salta al final del bucle.
         */
        <WHILE> c=Condition()
        {
            top = label();
            done = label();
        }
        b=Statements() <END>
        {
            return top + ":\n"
                + c
                + line("sifalsovea " + done)
                + b
                + line("vea " + top)
                + done + ":\n";
        }

      |
        /*
         * DO UNTIL: ejecuta primero el cuerpo y comprueba después
         * la condición. Cuando la condición es verdadera, termina.
         */
        <UNTIL> c=Condition()
        {
            top = label();
            done = label();
        }
        b=Statements() <END>
        {
            return top + ":\n"
                + b
                + c
                + line("siciertovea " + done)
                + line("vea " + top)
                + done + ":\n";
        }

      |
        /*
         * DO con contador: evalúa la expresión inicial una vez,
         * comprueba el límite en cada iteración y actualiza el contador.
         * BY permite indicar el incremento o decremento.
         */
        id=<ID> <EQ> e=Expression() <TO> s=Expression()
        {
            step = "1";
            subtract = false;
        }
        [
            <BY>
            [
                <ADDING>
              |
                <SUBTRACTING>
                {
                    subtract = true;
                }
            ]
            cadNum=<NUM>
            {
                step = cadNum.image;

                // Un incremento o decremento igual a cero no está permitido.
                if (step.matches("0+")) {
                    throw new IllegalArgumentException(
                        "BY no puede ser 0"
                    );
                }
            }
        ]
        {
            top = label();
            done = label();
            var = id.image.toUpperCase(Locale.ROOT);
        }
        b=Statements() <END>
        {
            // Inicialización del contador.
            init = line("valori " + var)
                 + e
                 + line("asigna");

            // Comprobación del límite del bucle.
            test = line("valord " + var)
                 + s
                 + line(subtract ? "esmenor" : "esmayor")
                 + line("siciertovea " + done);

            // Actualización del contador al terminar cada iteración.
            update = line("valori " + var)
                   + line("valord " + var)
                   + line("mete " + step)
                   + line(subtract ? "sub" : "add")
                   + line("asigna");

            return init
                + top + ":\n"
                + test
                + b
                + update
                + line("vea " + top)
                + done + ":\n";
        }
    )
}

/*
 * Condiciones:
 * una expresión aritmética puede aparecer sola o compararse
 * con otra expresión mediante un operador relacional.
 */
String Condition() :
{
    String a;
    String b;
    Token op;
}
{
    a=Expression()
    [
        (
            op=<EQ>
          | op=<NE>
          | op=<LT>
          | op=<GT>
          | op=<LE>
          | op=<GE>
        )
        b=Expression()
        {
            if (op.kind == EQ) {
                a += b + line("esigual");
            }
            else if (op.kind == NE) {
                a += b + line("esigual") + line("not");
            }
            else if (op.kind == LT) {
                a += b + line("esmenor");
            }
            else if (op.kind == GT) {
                a += b + line("esmayor");
            }
            else if (op.kind == LE) {
                a += b + line("esmayor") + line("not");
            }
            else {
                a += b + line("esmenor") + line("not");
            }
        }
    ]
    {
        return a;
    }
}

/*
 * Expresiones aritméticas de suma y resta.
 * La repetición permite procesar los operadores de izquierda a derecha.
 * La llamada a Term() establece la precedencia de multiplicación y división.
 */
String Expression() :
{
    String a;
    String b;
    Token op;
}
{
    a=Term()
    (
        (
            op=<PLUS>
          | op=<MINUS>
        )
        b=Term()
        {
            a += b + line(
                op.kind == PLUS ? "add" : "sub"
            );
        }
    )*
    {
        return a;
    }
}

/*
 * Términos con multiplicación y división.
 * Tienen mayor precedencia que la suma y la resta.
 */
String Term() :
{
    String a;
    String b;
    Token op;
}
{
    a=Unary()
    (
        (
            op=<STAR>
          | op=<SLASH>
        )
        b=Unary()
        {
            a += b + line(
                op.kind == STAR ? "mul" : "div"
            );
        }
    )*
    {
        return a;
    }
}

/*
 * Procesa los operadores unarios positivo y negativo.
 * El signo positivo no requiere generar una instrucción.
 * El negativo se traduce mediante cero menos el valor.
 */
String Unary() :
{
    String a;
    Token op;
}
{
    (
        (
            op=<PLUS>
          | op=<MINUS>
        )
        a=Unary()
        {
            return op.kind == PLUS
                ? a
                : line("mete 0") + a + line("sub");
        }
    )
  |
    a=Primary()
    {
        return a;
    }
}

/*
 * Elementos básicos de una expresión:
 * números, variables, expresiones entre paréntesis y CHOOSE.
 */
String Primary() :
{
    Token t;
    String a;
    String cond;
    String no;
    String yes;
}
{
    /*
     * Número entero: se introduce directamente en la pila.
     */
    t=<NUM>
    {
        return line("mete " + t.image);
    }

  |
    /*
     * Variable: se obtiene su valor y se coloca en la pila.
     */
    t=<ID>
    {
        return line(
            "valord " + t.image.toUpperCase(Locale.ROOT)
        );
    }

  |
    /*
     * Expresión entre paréntesis: conserva el resultado de la expresión.
     */
    <LP> a=Expression() <RP>
    {
        return a;
    }

  |
    /*
     * CHOOSE(condición, expresión verdadera, expresión falsa).
     * Los saltos hacen que solo se evalúe la expresión seleccionada.
     */
    <CHOOSE> <LP>
    cond=Condition() <COMMA>
    yes=Expression() <COMMA>
    no=Expression() <RP>
    {
        String otherwise = label();
        String done = label();

        return cond
            + line("sifalsovea " + otherwise)
            + yes
            + line("vea " + done)
            + otherwise + ":\n"
            + no
            + done + ":\n";
    }
}
