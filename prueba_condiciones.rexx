/* CONDICIONES CON Y SIN COMPARADOR */

A = 1
B = 0

IF A THEN DO
    SAY "A ES DISTINTO DE CERO"
END

IF B THEN DO
    SAY "ERROR"
END

IF A <> B THEN DO
    SAY "DISTINTOS"
END

IF A = B THEN DO
    SAY "ERROR IGUALES"
END

IF A >= B THEN DO
    SAY "A MAYOR O IGUAL"
END

IF B <= A THEN DO
    SAY "B MENOR O IGUAL"
END